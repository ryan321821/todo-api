# ========== Python 相关 ==========
# Python 运行时自动生成的字节码缓存目录
__pycache__/
# Python 编译缓存文件
*.py[cod]
# 虚拟环境目录（本项目没用，但养成忽略的习惯）
.venv/
venv/

# ========== 测试相关 ==========
.pytest_cache/
.coverage
htmlcov/

# ========== 编辑器 / IDE ==========
.idea/
.vscode/

# ========== 密钥与环境变量 ==========
